                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>




    <!--Para validar la cedula-->
    <script>
        function handleEstadoChange(select, idPaquete, cedulaReceptor) {
            if (select.value === "Entregado") {
                const modal = new bootstrap.Modal(document.getElementById('cedulaModal'));
                document.getElementById('modalIdPaquete').value = idPaquete;
                document.getElementById('modalEstado').value = select.value;
                document.getElementById('modalCedula').value = '';
                modal.show();
            } else if (select.value) {
                // Esto envia el estado automaticamente, no se hace validacion de cedula
                document.getElementById(`form-estado-${idPaquete}`).submit();
            }
        }
    </script>



