                    @using (Html.BeginForm("AsignarPaqueteAEnvioSJ", "PaquetesEnviosController", FormMethod.Post, new { id = "formPaquetes" }))
                    {
                        @Html.AntiForgeryToken()
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Número de Rastreo</th>
                                    <th>Emisor</th>
                                    <th>Receptor</th>
                                    <th>Estado</th>
                                    <th>Asignar a Envios</th>
                                </tr>
                            </thead>
                            <tbody id="paquetesTableBody">
                                @for (int i = 0; i < Model.Paquetes.Count; i++)
                                {
                                    var paquete = Model.Paquetes[i];
                                    <tr>
                                        <td>@paquete.NumeroRastreo</td>
                                        <td>@paquete.NombreEmisor</td>
                                        <td>@paquete.NombreReceptor</td>
                                        <td>@paquete.Estado.ToString()</td>
                                        <td>
                                            @Html.Hidden($"PaqueteEnvioAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)
                                            <select name=$"PaqueteEnvioAsignaciones[{i}].IdEnvio" class="form-control">
                                                <option value="">Seleccionar Envio</option>
                                                @foreach (var envio in Model.Envios)
                                                {
                                                    <option value="@envio.Id_Envio">
                                                        @envio.Descripcion - Usuario: @envio.Usuario.Nombre
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button type="submit" class="btn btn-primary">Asignar Envio</button>
                    }
