@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteEnvioViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}




    <head>
        <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    </head>

    <h1 class="text-center">Envios Domicilios San Jose</h1>


    <br>
    <div class="d-flex justify-content-center ">
        <a href="@Url.Action("VistaCargaTransito", "PaquetesCargasController")" class="btn btn-primary">
            <i class="fa fa-truck"></i> Ver cargas en Transito
        </a>
    </div>

    <div class="container mt-5">
        @if (Session["Usuario"] != null)
        {
            int? sedeValue = Session["Sede"] as int?;
            string sedeTexto = sedeValue.HasValue ?
                ((Sede)sedeValue.Value == Sede.SanJose ? "San José" : "Perez Zeledón") :
                "";

            <h2 class="navbar-text">Lista de Envios @sedeTexto</h2>
        }

        <br>
        <br>

        <div class="row">


            <div class="row">
                <div class="col-md-12">
                    <h3>Paquetes</h3>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <input type="text" id="searchPaqueteInput" class="form-control" placeholder="Buscar por Número de Rastreo...">
                        </div>
                    </div>

                    @using (Html.BeginForm("AsignarPaqueteAEnvioSJ", "PaquetesEnviosController", FormMethod.Post, new { id = "formPaquetes" }))
                    {
                        @Html.AntiForgeryToken()
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Número de Rastreo</th>
                                    <th>Emisor</th>
                                    <th>Receptor</th>
                                    <th>Estado</th>
                                    <th>Asignar a Envios</th>
                                </tr>
                            </thead>
                            <tbody id="paquetesTableBody">
                                @for (int i = 0; i < Model.Paquetes.Count; i++)
                                {
                                    var paquete = Model.Paquetes[i];
                                    <tr>
                                        <td>@paquete.NumeroRastreo</td>
                                        <td>@paquete.NombreEmisor</td>
                                        <td>@paquete.NombreReceptor</td>
                                        <td>@paquete.Estado.ToString()</td>
                                        <td>
                                            @Html.Hidden($"PaqueteEnvioAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)
                                            <select name=$"PaqueteEnvioAsignaciones[{i}].IdEnvio" class="form-control">
                                                <option value="">Seleccionar Envio</option>
                                                @foreach (var envio in Model.Envios)
                                                {
                                                    <option value="@envio.Id_Envio">
                                                        @envio.Descripcion - Usuario: @envio.Usuario.Nombre
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button type="submit" class="btn btn-primary">Asignar Envio</button>
                    }
                </div>
            </div>

            <div id="pagination" class="d-flex justify-content-center mt-3">
                <ul class="pagination" id="paginationLinks">
                    <!-- Pagination links will be dynamically generated -->
                </ul>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const tableBody = document.getElementById('paquetesTableBody');
                    const searchInput = document.getElementById('searchPaqueteInput');
                    const itemsPerPage = 10;
                    let currentPage = 1;
                    let filteredData = [];

                    // Prepare data
                    const originalRows = Array.from(tableBody.querySelectorAll('tr'));

                    // Search functionality
                    function performSearch() {
                        const searchTerm = searchInput.value.toLowerCase();
                        filteredData = originalRows.filter(row => {
                            const rastreo = row.querySelector('td:first-child').textContent.toLowerCase();
                            return rastreo.includes(searchTerm);
                        });

                        currentPage = 1;
                        renderTable();
                        renderPagination();
                    }

                    // Pagination rendering
                    function renderTable() {
                        tableBody.innerHTML = '';

                        const startIndex = (currentPage - 1) * itemsPerPage;
                        const endIndex = startIndex + itemsPerPage;

                        const pageData = filteredData.slice(startIndex, endIndex);
                        pageData.forEach(row => tableBody.appendChild(row));
                    }

                    function renderPagination() {
                        const paginationContainer = document.getElementById('paginationLinks');
                        paginationContainer.innerHTML = '';

                        const totalPages = Math.ceil(filteredData.length / itemsPerPage);

                        if (currentPage > 1) {
                            const prevLi = document.createElement('li');
                            prevLi.className = 'page-item';
                            const prevLink = document.createElement('a');
                            prevLink.className = 'page-link';
                            prevLink.href = '#';
                            prevLink.textContent = 'Anterior';
                            prevLink.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPage--;
                                renderTable();
                                renderPagination();
                            });
                            prevLi.appendChild(prevLink);
                            paginationContainer.appendChild(prevLi);
                        }

                        for (let i = 1; i <= totalPages; i++) {
                            const li = document.createElement('li');
                            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
                            const link = document.createElement('a');
                            link.className = 'page-link';
                            link.href = '#';
                            link.textContent = i;
                            link.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPage = i;
                                renderTable();
                                renderPagination();
                            });
                            li.appendChild(link);
                            paginationContainer.appendChild(li);
                        }

                        if (currentPage < totalPages) {
                            const nextLi = document.createElement('li');
                            nextLi.className = 'page-item';
                            const nextLink = document.createElement('a');
                            nextLink.className = 'page-link';
                            nextLink.href = '#';
                            nextLink.textContent = 'Siguiente';
                            nextLink.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPage++;
                                renderTable();
                                renderPagination();
                            });
                            nextLi.appendChild(nextLink);
                            paginationContainer.appendChild(nextLi);
                        }
                    }

                    filteredData = originalRows;
                    renderTable();
                    renderPagination();

                    searchInput.addEventListener('input', performSearch);
                });
            </script>




            <h3>Envios</h3>
            <br>
            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text" id="searchEnviosInput" class="form-control" placeholder="Buscar por ID Carga...">
                    <a href="@Url.Action("Create", "Envios")" class="btn btn-danger">
                        <i class="fas fa-user-plus"></i> Agregar Envio
                    </a>
                </div>
            </div>
 
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id Carga</th>
                            <th>Transportista</th>
                            <th>Estado</th>
                            <th>Paquetes Asignados</th>
                            <th>Ver Paquetes</th>
                            <th>Editar Envio</th>
                            <th>Cambiar Estado</th>
                        </tr>
                    </thead>
                    <tbody id="enviosTableBody">
                        @foreach (var envio in Model.Envios)
                        {
                            <tr>
                                <td>@envio.Id_Envio</td>
                                <td>@envio.Usuario.Nombre</td>
                                <td>@envio.Estado.ToString()</td>
                                <td>@envio.NumeroPaquetes</td>
                                <td>
                                    <a href="@Url.Action("EnvioPaquetes", "PaquetesEnviosController", new { idEnvio = envio.Id_Envio })" class="btn btn-success">
                                        Ver
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Envios", new { id = envio.Id_Envio })" class="btn btn-primary">
                                        Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Envios", new { id = envio.Id_Envio })" class="btn btn-danger">
                                        Borrar
                                    </a>
                                </td>
                                <td>
                                    @using (Html.BeginForm("ActualizarEstadoEnvioSJ", "PaquetesEnviosController", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("idEnvio", envio.Id_Envio)

                                        <select name="nuevoEstado" class="form-control">
                                            <option value="">Estado</option>
                                            <option value="BodegaSJ">BodegaSJ</option>
                                            <option value="EnTransito">EnTransito</option>
                                        </select>

                                        <button type="submit" class="btn btn-danger mt-2">Actualizar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const tableBody = document.getElementById('enviosTableBody');
                    const searchInput = document.getElementById('searchEnviosInput');

                    // Search functionality
                    searchInput.addEventListener('input', function () {
                        const searchTerm = searchInput.value.toLowerCase();
                        const rows = Array.from(tableBody.querySelectorAll('tr'));

                        rows.forEach(row => {
                            const idEnvio = row.querySelector('td:first-child').textContent.toLowerCase();
                            if (idEnvio.includes(searchTerm)) {
                                row.style.display = '';
                            } else {
                                row.style.display = 'none';
                            }
                        });
                    });
                });
            </script>

