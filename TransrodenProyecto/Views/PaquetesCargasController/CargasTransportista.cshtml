@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



    <div class="container mt-5">

        <!-- Cargas para enviar -->
        <h2 class="text-center">Cargas Asignadas</h2>

        <div class="row mb-3">
            <div class="col-md-6">
                <input type="text" id="searchInput" class="form-control" placeholder="Buscar por ID, Transportista o Estado...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped" id="cargasTable">
                <thead>
                    <tr>
                        <th>Id Carga</th>
                        <th>Transportista</th>
                        <th>Estado</th>
                        <th>Paquetes Asignados</th>
                        <th>Ver Paquetes</th>
                        <th>Cambiar Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var carga in Model.Cargas)
                    {
                        <tr>
                            <td>@carga.Id_Carga</td>
                            <td>@carga.Usuario.Nombre</td>
                            <td>@carga.Estado.ToString()</td>
                            <td>@carga.NumeroPaquetes</td>
                            <td>
                                <a href="@Url.Action("CargaPaquetesViewTransp", "PaquetesCargasController", new { idCarga = carga.Id_Carga })" class="btn btn-success btn-sm">
                                    Ver Paquetes
                                </a>
                            </td>
                            <td>
                                <form action="@Url.Action("EstadoCargaTransp", "PaquetesCargasController")" method="post" class="estado-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idCarga" value="@carga.Id_Carga" />
                                    <div class="input-group">
                                        <select name="nuevoEstado" class="form-control form-control-sm estado-select">
                                            <option value="">Seleccionar Estado</option>
                                            <option value="Averia">Avería</option>
                                        </select>
                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-danger btn-sm ml-2">Actualizar</button>
                                        </div>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div class="pagination-container text-center mt-3">
            <nav>
                <ul class="pagination" id="pagination"></ul>
            </nav>
        </div>
    </div>

    <script>
        // Configuración de paginación
        const rowsPerPage = 10;
        let currentPage = 1;
        const table = document.getElementById('cargasTable');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const totalPages = Math.ceil(rows.length / rowsPerPage);

        function renderPage() {
            tbody.innerHTML = '';
            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const pageRows = rows.slice(start, end);

            pageRows.forEach(row => tbody.appendChild(row));
            renderPagination();
        }

        function renderPagination() {
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${i === currentPage ? 'active' : ''}`;
                const link = document.createElement('a');
                link.className = 'page-link';
                link.href = '#';
                link.textContent = i;

                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    currentPage = i;
                    renderPage();
                });

                li.appendChild(link);
                pagination.appendChild(li);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            renderPage();
        });
    </script>



    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const table = document.getElementById('cargasTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            // Real-time search functionality
            searchInput.addEventListener('keyup', function () {
                const searchTerm = this.value.toLowerCase();

                Array.from(rows).forEach(row => {
                    const idCarga = row.cells[0].textContent.toLowerCase();
                    const transportista = row.cells[1].textContent.toLowerCase();
                    const estado = row.cells[2].textContent.toLowerCase();

                    const isVisible =
                        idCarga.includes(searchTerm) ||
                        transportista.includes(searchTerm) ||
                        estado.includes(searchTerm);

                    row.style.display = isVisible ? '' : 'none';
                });
            });

            // Form submission handling
            const forms = document.querySelectorAll('.estado-form');
            forms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    const estadoSelect = this.querySelector('.estado-select');

                    if (estadoSelect.value === '') {
                        e.preventDefault();
                        alert('Por favor, seleccione un estado');
                    }
                });
            });
        });
    </script>



