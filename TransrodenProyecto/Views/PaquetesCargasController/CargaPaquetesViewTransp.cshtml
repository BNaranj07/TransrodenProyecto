@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>LifeSure - Life Insurance Website Template</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link rel="stylesheet" href="~/Content/assets/lib/animate/animate.min.css" />
    <link href="~/Content/assets/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/Content/assets/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/Content/assets/css/style.css" rel="stylesheet">
</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->
    <!-- Topbar -->
    <div class="container-fluid topbar px-0 px-lg-4 bg-light py-2 d-none d-lg-block">
        <div class="container">
            <div class="row gx-0 align-items-center">
                <div class="col-lg-8 text-center text-lg-start mb-lg-0">
                    <div class="d-flex flex-wrap">
                        <div class="border-end border-primary pe-3">
                            <a href="#" class="text-muted small"><i class="fas fa-house-user text-primary me-2"></i>ESTE ES EL MODULO DE ADMINISTRATIVO</a>
                        </div>
                        <div class="ps-3">
                            <a href="mailto:example@gmail.com" class="text-muted small"></i> <!-- Aqui puede ir el nombre del usuario--></a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-center text-lg-end">
                    <div class="d-flex justify-content-end">
                        <div class="d-flex border-end border-primary pe-3">
                            <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-twitter"></i></a>
                            <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-instagram"></i></a>
                        </div>
                        <!--
                        <div class="dropdown ms-3">
                            <a href="#" class="dropdown-toggle text-dark" data-bs-toggle="dropdown"><small><i class="fas fa-globe-europe text-primary me-2"></i> English</small></a>
                            <div class="dropdown-menu rounded">
                                <a href="#" class="dropdown-item">English</a>
                                <a href="#" class="dropdown-item">Bangla</a>
                                <a href="#" class="dropdown-item">French</a>
                                <a href="#" class="dropdown-item">Spanish</a>
                                <a href="#" class="dropdown-item">Arabic</a>
                            </div>
                        </div>
                        -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar -->
    <!-- Navbar -->
    <div class="container-fluid nav-bar px-0 px-lg-0 py-lg-0" id="maincontainer">
        <div class="container" id="containertop">
            <nav class="navbar navbar-expand-lg navbar-light">
                <!-- <a href="#" class="navbar-brand p-0"> -->
                <!--<h1 class="text-primary mb-0"><i class="fab fa-slack me-2"></i> LifeSure</h1> -->
                <img src="~/Content/assets/img/Logo.png" alt="Logo" width="230" height="150">
                <!-- </a> -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">

                    <div class="navbar-nav mx-0 mx-lg-auto">
                        <!-- <a href="index.html" class="nav-item nav-link active">Inicio</a> -->
                        <a href="@Url.Action("IndexTransportista", "Admin")" class="nav-item nav-link active">
                            Inicio
                        </a>


                        <a href="about.html" class="nav-item nav-link">
                            Cuenta
                        </a>


                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link" data-bs-toggle="dropdown">
                                <span class="dropdown-toggle">Tracking</span>
                            </a>
                            <div class="dropdown-menu">
                                <a href="@Url.Action("AsignTransportista", "Admin")" class="dropdown-item">Tracking Admin</a>
                                <a href="@Url.Action("TrackingAdmin", "Modulo4")" class="dropdown-item">Rastreo Paquete</a>
                            </div>
                        </div>


                        @if (Session["Usuario"] != null)
                        {
                            <a href="@Url.Action("Logout", "Cuenta")" class="nav-item nav-link">
                                <span class="d-block"><i class="fas fa-sign-out-alt"></i></span>
                                @Session["Usuario"]
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Cuenta")" class="nav-item nav-link">
                                <span class="d-block"><i class="fas fa-user"></i></span>
                                Cuenta
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- Navbar -->

    <h2 class="text-center">Paquetes de la Carga</h2>
    <div class="container mt-5">
        <h4>Transportista: @Model.Cargas.First().Usuario.Nombre</h4>
        <h4>Estado: @Model.Cargas.First().Estado.ToString()</h4>
        <h4>Paquetes Asignados: @Model.Cargas.First().NumeroPaquetes</h4>

        <div class="mb-3">
            <input type="text" id="searchInput" class="form-control" placeholder="Buscar por Número de Rastreo"
                   value="@ViewBag.SearchTerm" onkeyup="searchPackages()">
        </div>

        <table class="table mt-4" id="packagesTable">
            <thead>
                <tr>
                    <th>Número de Rastreo</th>
                    <th>Emisor</th>
                    <th>Receptor</th>
                    <th>Estado</th>
                    <th>Detalles del Paquete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paquete in Model.Paquetes)
                {
                    <tr>
                        <td>@paquete.NumeroRastreo</td>
                        <td>@paquete.NombreEmisor</td>
                        <td>@paquete.NombreReceptor</td>
                        <td>@paquete.Estado.ToString()</td>
                        <td>
                            <a href="@Url.Action("DetailsTransp", "Paquetes", new { id = paquete.Id_Paquete })" class="btn btn-primary">
                                Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("CargaPaquetesViewTransp", new { idCarga = ViewBag.IdCarga, page = i, searchTerm = ViewBag.SearchTerm })">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>

    <script>
    function searchPackages() {
        var searchTerm = document.getElementById('searchInput').value;
        var idCarga = @ViewBag.IdCarga;

        // Redirect with search term
        window.location.href = '@Url.Action("CargaPaquetesViewTransp")' +
            '?idCarga=' + idCarga +
            '&searchTerm=' + encodeURIComponent(searchTerm) +
            '&page=1';
    }
    </script>

    <br>
    <br>



    <!-- Footer Start -->
    <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-xl-9">
                    <div class="mb-5">
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-6 col-xl-5">
                                <div class="footer-item">
                                    <a href="index.html" class="p-0">
                                        <h3 class="text-white"><i class="fas fa-truck-loading me-3"></i> Transroden Express SA</h3>
                                        <!-- <img src="~/Content/assets/img/logo.png" alt="Logo"> -->
                                    </a>
                                    <p class="text-white mb-4">Dolor amet sit justo amet elitr clita ipsum elitr est.Lorem ipsum dolor sit amet, consectetur adipiscing...</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-6 col-xl-3">
                                <div class="footer-item">
                                    <h4 class="text-white mb-4">Acceso Rapido</h4>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Inicio </a>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Administracion </a>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Clientes </a>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Inventario </a>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-6 col-xl-3">
                                <div class="footer-item">
                                    <h4 class="mb-4" style="color: rgb(192, 27, 28);">Acceso Rápido</h4>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Tracking </a>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Contabilidad </a>
                                    <a href="#" class="text-white"><i class="text-white fas fa-angle-right me-2"></i> Mercadeo </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Copyright Start -->
    <div class="container-fluid copyright py-4">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-end mb-md-0">
                    <span class="text-body"><a href="#" class="border-bottom text-white"><i class="fas fa-copyright text-light me-2"></i>transroden.com</a>, Todos los derechos reservados 2024.</span>
                </div>
                <div class="col-md-6 text-center text-md-start text-body">
                    <!--/*** This template is free as long as you keep the below author’s credit link/attribution link/backlink. ***/-->
                    <!--/*** If you'd like to use the template without the below author’s credit link/attribution link/backlink, ***/-->
