        <div class="container-fluid">
            <h3 class="mb-4">Paquetes Sin Carga Asignada - Perez Zeledon</h3>

            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar por número de rastreo...">
                </div>
            </div>

            @using (Html.BeginForm("AsignarPaqueteACargaPZ", "PaquetesCargasController", FormMethod.Post, new { id = "assignPackageFormPZ" }))
            {
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table table-striped" id="packagesTablePZ">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAllCheckboxPZ">
                                </th>
                                <th>Número de Rastreo</th>
                                <th>Emisor</th>
                                <th>Receptor</th>
                                <th>Estado</th>
                                <th>Asignar a Carga</th>
                            </tr>
                        </thead>
                        <tbody id="packagesTableBodyPZ">
                            @for (int i = 0; i < Model.Paquetes.Count; i++)
                            {
                                var paquete = Model.Paquetes[i];
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedPaquetesPZ" value="@paquete.Id_Paquete" class="package-checkboxPZ">
                                    </td>
                                    <td>@paquete.NumeroRastreo</td>
                                    <td>@paquete.NombreEmisor</td>
                                    <td>@paquete.NombreReceptor</td>
                                    <td>@paquete.Estado.ToString()</td>
                                    <td>
                                        <select name="PaqueteCargaAsignaciones[@i].IdCarga" class="form-control carga-selectPZ">
                                            <option value="">Seleccionar Carga</option>
                                            @foreach (var carga in Model.Cargas)
                                            {
                                                <option value="@carga.Id_Carga">
                                                    Carga: @carga.Id_Carga - Camionero: @carga.Usuario.Nombre
                                                </option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <select id="cargaMasivaPZ" class="form-control">
                                <option value="">Asignación Masiva de Carga</option>
                                @foreach (var carga in Model.Cargas)
                                {
                                    <option value="@carga.Id_Carga">
                                        Carga: @carga.Id_Carga - Camionero: @carga.Usuario.Nombre
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 text-right">
                        <button type="submit" class="btn btn-success">Asignar Carga</button>
                    </div>
                </div>

                <div id="paginationPZ" class="d-flex justify-content-center mt-3">
                    <ul class="pagination" id="paginationLinksPZ">
                        <!-- Pagination links will be dynamically generated -->
                    </ul>
                </div>
            }

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const tableBodyPZ = document.getElementById('packagesTableBodyPZ');
                    const paginationContainerPZ = document.getElementById('paginationLinksPZ');
                    const itemsPerPagePZ = 10;
                    let currentPagePZ = 1;

                    // Prepare data
                    const originalRowsPZ = Array.from(tableBodyPZ.querySelectorAll('tr'));

                    // Render table based on current page
                    function renderPackagesTablePZ() {
                        tableBodyPZ.innerHTML = ''; // Clear table

                        const startIndex = (currentPagePZ - 1) * itemsPerPagePZ;
                        const endIndex = startIndex + itemsPerPagePZ;

                        originalRowsPZ.slice(startIndex, endIndex).forEach(row => {
                            tableBodyPZ.appendChild(row);
                        });
                    }

                    // Render pagination links
                    function renderPaginationPZ() {
                        paginationContainerPZ.innerHTML = '';

                        const totalPagesPZ = Math.ceil(originalRowsPZ.length / itemsPerPagePZ);

                        if (currentPagePZ > 1) {
                            const prevLiPZ = document.createElement('li');
                            prevLiPZ.className = 'page-item';
                            const prevLinkPZ = document.createElement('a');
                            prevLinkPZ.className = 'page-link';
                            prevLinkPZ.href = '#';
                            prevLinkPZ.textContent = 'Anterior';
                            prevLinkPZ.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPagePZ--;
                                renderPackagesTablePZ();
                                renderPaginationPZ();
                            });
                            prevLiPZ.appendChild(prevLinkPZ);
                            paginationContainerPZ.appendChild(prevLiPZ);
                        }

                        for (let i = 1; i <= totalPagesPZ; i++) {
                            const liPZ = document.createElement('li');
                            liPZ.className = `page-item ${i === currentPagePZ ? 'active' : ''}`;
                            const linkPZ = document.createElement('a');
                            linkPZ.className = 'page-link';
                            linkPZ.href = '#';
                            linkPZ.textContent = i;
                            linkPZ.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPagePZ = i;
                                renderPackagesTablePZ();
                                renderPaginationPZ();
                            });
                            liPZ.appendChild(linkPZ);
                            paginationContainerPZ.appendChild(liPZ);
                        }

                        if (currentPagePZ < totalPagesPZ) {
                            const nextLiPZ = document.createElement('li');
                            nextLiPZ.className = 'page-item';
                            const nextLinkPZ = document.createElement('a');
                            nextLinkPZ.className = 'page-link';
                            nextLinkPZ.href = '#';
                            nextLinkPZ.textContent = 'Siguiente';
                            nextLinkPZ.addEventListener('click', (e) => {
                                e.preventDefault();
                                currentPagePZ++;
                                renderPackagesTablePZ();
                                renderPaginationPZ();
                            });
                            nextLiPZ.appendChild(nextLinkPZ);
                            paginationContainerPZ.appendChild(nextLiPZ);
                        }
                    }

                    // Initialize table and pagination
                    renderPackagesTablePZ();
                    renderPaginationPZ();
                });
            </script>


            <style>
                .pagination {
                    display: flex;
                    justify-content: center;
                    align-items: center;
