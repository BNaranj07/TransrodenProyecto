                                <option value="EnviarImportante">AVISO IMPORTANTE!</option>
                            </select>
                        </div>


                        <div class="display-6 mb-3">
                            <label for="asunto" class="form-label">Asunto</label>
                            <textarea class="form-control" id="asunto" name="Asunto" rows="2" placeholder="Escriba el asunto de la notificación" required></textarea>
                        </div>
                        <div class="display-6 mb-3">
                            <label for="mensaje" class="form-label">Mensaje</label>
                            <textarea class="form-control" id="mensaje" name="Mensaje" rows="6" placeholder="Escriba el mensaje de la notificación" required></textarea>
                        </div>
                        <div class="display-6 mb-3">
                            <label for="imagen" class="form-label">Subir Imagen</label>
                            <input type="file" class="form-control" id="imagen" name="Imagen" accept="image/*" onchange="previewImage(event)">
                            <div class="mt-3">
                                <img id="preview" src="#" alt="Vista previa de la imagen" style="display: none; max-width: 200px; max-height: 200px;" />
                            </div>
                        </div>
                        <div class="text-center">
                            <button type="submit" id="submitBtn" class="btn btn-lg" style="background-color: #cccccc; border-color: #cccccc; color: #666666;" disabled>Enviar Notificación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
