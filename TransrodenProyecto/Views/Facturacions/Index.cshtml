@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">


    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Facturacions")" class="btn btn-danger">
            <i class="fas fa-box-plus"></i> Agregar Factura
        </a>
    </div>


    <!-- Barra de búsqueda -->
    <form method="get" action="@Url.Action("Index", "Facturacions")">
        <div class="form-group">
            <label for="searchId">Buscar Factura:</label>
            <input type="number" name="searchId" id="searchId" class="form-control" placeholder="Ingrese ID de la Factura" />
            <br>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
    <!-- Topbar -->
    <!-- Navbar -->
    <div class="container-fluid nav-bar px-0 px-lg-0 py-lg-0" id="maincontainer">
        <div class="container" id="containertop">
            <nav class="navbar navbar-expand-lg navbar-light">

                <img src="~/Content/assets/img/Logo.png" alt="Logo" width="230" height="150">

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">

                    <div class="navbar-nav mx-0 mx-lg-auto">

                        <a href="@Url.Action("IndexAdmin", "Admin")" class="nav-item nav-link active">
                            Inicio
                        </a>

                        <a href="@Url.Action("Index","Usuarios")" class="nav-item nav-link">
                            Usuarios
                        </a>

                        <a href="@Url.Action("Index","Paquetes")" class="nav-item nav-link">
                            Paqueteria
                        </a>

                        @if (Session["Usuario"] != null)
                        {
                            // Obtener la sede del usuario desde la sesión
                            var sedeUsuario = Session["Sede"] != null ? (Sede)Session["Sede"] : Sede.SanJose; // Valor por defecto

                            // Determinar la URL según la sede
                            string urlCargas;
                            if (sedeUsuario == Sede.SanJose)
                            {
                                urlCargas = Url.Action("DashboardSJ", "PaquetesCargasController");
                            }
                            else if (sedeUsuario == Sede.PerezZeledon)
                            {
                                urlCargas = Url.Action("DashBoardPZ", "PaquetesCargasController");
                            }
                            else
                            {
                                urlCargas = "#"; // En caso de que la sede no sea válida, puedes redirigir a una página de error o similar.
                            }

                            // Enlace a Cargas
                            <a href="@urlCargas" class="nav-item nav-link">Tracking</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Cuenta")" class="nav-item nav-link">
                                <span class="d-block"><i class="fas fa-user"></i></span>
                                Cuenta
                            </a>
                        }

                        <a href="@Url.Action("Index","Facturacions")" class="nav-item nav-link">
                            Facturacion
                        </a>


                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link" data-bs-toggle="dropdown">
                                <span class="dropdown-toggle">Contabilidad</span>
                            </a>
                            <div class="dropdown-menu">
                                <a href="@Url.Action("ContabilidadDiaria", "Contabilidad")" class="dropdown-item">Consulta Diaria</a>
                                <a href="@Url.Action("ContabilidadSemanal", "Contabilidad")" class="dropdown-item">Consulta Semanal</a>
                                <a href="@Url.Action("ContabilidadMensual", "Contabilidad")" class="dropdown-item">Consulta Mensual</a>
                                <a href="@Url.Action("ContabilidadAnual", "Contabilidad")" class="dropdown-item">Consulta Anual</a>
                            </div>
                        </div>




                        <a href="@Url.Action("Marketing","Modulo6")" class="nav-item nav-link" id="contact">
                            Mercadeo
                        </a>



                        @if (Session["Usuario"] != null)
                        {
                            <a href="@Url.Action("Logout", "Cuenta")" class="nav-item nav-link">
                                <span class="d-block"><i class="fas fa-sign-out-alt"></i></span>
                                @Session["Usuario"]
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Cuenta")" class="nav-item nav-link">
                                <span class="d-block"><i class="fas fa-user"></i></span>
                                Cuenta
                            </a>
                        }

                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- Navbar -->



    <div class="container mt-5">
        <div class="d-flex justify-content-end mb-4">
            <a href="@Url.Action("Create", "Facturacions")" class="btn btn-danger">
                <i class="fas fa-box-plus"></i> Agregar Factura
            </a>
        </div>

        <!-- Barra de búsqueda -->
        <div class="form-group">
            <label for="searchId">Buscar Factura:</label>
            <input type="number" id="searchId" class="form-control" placeholder="Ingrese ID de la Factura" />
        </div>

        <br>
        <h2>Lista de Facturaciones</h2>
        <div style="overflow-y: auto; max-height: 400px;">
            <table class="table" id="facturacionTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id_Facturacion)</th>
                        <th>@Html.DisplayNameFor(model => model.Paquete.NumeroRastreo)</th>
                        <th>@Html.DisplayNameFor(model => model.Usuario.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.NombreEmisor)</th>
                        <th>@Html.DisplayNameFor(model => model.CedulaEmisor)</th>
                        <th>@Html.DisplayNameFor(model => model.Precio)</th>
                        <th>@Html.DisplayNameFor(model => model.Iva)</th>
                        <th>@Html.DisplayNameFor(model => model.Total)</th>
                        
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Contenido dinámico -->
                </tbody>
            </table>
        </div>
        <nav>
            <ul class="pagination" id="pagination"></ul>
        </nav>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
$(document).ready(function () {
    let currentPage = 1;

    function loadFacturaciones(page, searchId = '') {
        $.ajax({
            url: '@Url.Action("GetFacturaciones", "Facturacions")',
            type: 'GET',
            data: { page: page, searchId: searchId },
            success: function (response) {
                const facturaciones = response.data;
                const totalPages = response.totalPages;

                let tableBody = '';
                facturaciones.forEach(factura => {
                    tableBody += `
                        <tr>
                            <td>${factura.Id_Facturacion}</td>
                            <td>${factura.Paquete?.NumeroRastreo || '-'}</td>
                            <td>${factura.Usuario?.Nombre || '-'}</td>
                            <td>${factura.NombreEmisor}</td>
                            <td>${factura.CedulaEmisor}</td>
                            <td>${factura.Precio}</td>
                            <td>${factura.Iva}</td>
                            <td>${factura.Total}</td>
                            
                            <td>
                                <a href="/Facturacions/Edit/${factura.Id_Facturacion}" class="btn btn-success">Editar</a>
                                <a href="/Facturacions/DetalleFacturacion/${factura.Id_Facturacion}" class="btn btn-primary">Detalle</a>
                                <a href="/Facturacions/Delete/${factura.Id_Facturacion}" class="btn btn-danger">Borrar</a>
                            </td>
                        </tr>`;
                });

                $('#facturacionTable tbody').html(tableBody);
                renderPagination(totalPages, searchId);
            }
        });
    }

    function renderPagination(totalPages, searchId = '') {
        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                <li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#">${i}</a>
                </li>`;
        }

        $('#pagination').html(paginationHtml);

        $('#pagination .page-link').click(function (e) {
            e.preventDefault();
            currentPage = parseInt($(this).text());
            loadFacturaciones(currentPage, searchId);
        });
    }

    // Actualizar la búsqueda en tiempo real
    $('#searchId').on('keyup', function () {
        const searchId = $(this).val();
        currentPage = 1; // Reiniciar a la primera página
        loadFacturaciones(currentPage, searchId);
    });

    // Cargar facturaciones iniciales
    loadFacturaciones(currentPage);
});
    </script>


